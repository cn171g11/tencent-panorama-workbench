* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
# Existing datasets keep their historical blob bytes and line endings.
*.json -text
*.geojson -text
*.py text eol=lf
# Preserve the exact pinned upstream module, including its original final blank line.
city-viewer/vendor/brotli-wasm/brotli_wasm.mjs -text whitespace=-blank-at-eof
